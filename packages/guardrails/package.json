{
  "name": "@krama/guardrails",
  "version": "0.1.0",
  "private": true,
  "description": "Krama guardrail rule engine + `krama-guardrails` CLI (runs server-side as a required GitHub status check)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "krama-guardrails": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@krama/shared": "workspace:*",
    "commander": "15.1.0"
  }
}
