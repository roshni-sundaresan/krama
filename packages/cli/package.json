{
  "name": "@krama/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Krama developer CLI: check prerequisites, pull context pack, run approved local coding tool, push krama-gen branch",
  "type": "module",
  "bin": {
    "krama": "./dist/index.js"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "krama": "node dist/index.js"
  },
  "dependencies": {
    "@krama/shared": "workspace:*",
    "commander": "15.1.0"
  }
}
