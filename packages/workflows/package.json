{
  "name": "@krama/workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Temporal orchestration for Krama: documentationWorkflow + TS worker (AI activities run on the Python 'ai' task queue)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "worker": "node --env-file-if-exists=../../.env dist/worker.js"
  },
  "dependencies": {
    "@krama/shared": "workspace:*",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0"
  }
}
