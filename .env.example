# Krama — local environment. Copy to .env (repo root) and adjust.
# Used by apps/api, apps/web, packages/workflows (TS worker), workers/ai and infra/docker-compose.yml.

# ---------- Shared secrets (CHANGE for any shared environment) ----------
# API JWT signing secret (>= 16 chars).
API_JWT_SECRET=dev-only-change-me-0123456789abcdef
# Worker -> API callback secret (>= 16 chars).
INTERNAL_API_TOKEN=dev-internal-token-change-me-0123
# Auth.js session encryption secret for apps/web (generate: openssl rand -base64 32).
AUTH_SECRET=dev-auth-secret-change-me-0123456789abcdef

# ---------- Database (PostgreSQL 16 + pgvector) ----------
POSTGRES_USER=krama
POSTGRES_PASSWORD=krama
POSTGRES_DB=krama
DATABASE_URL=postgresql://krama:krama@localhost:5432/krama?schema=public

# ---------- API ----------
PORT=4000
WEB_ORIGIN=http://localhost:3000
DEFAULT_TENANT_SLUG=idealake
# Mock login (dev only). MUST be false in shared/prod environments.
AUTH_DEV_LOGIN=true

# ---------- Web (Next.js + Auth.js) ----------
# Server-side URL the web app and TS worker use to call the API.
KRAMA_API_URL=http://localhost:4000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Shows the dev credentials provider on the sign-in page.
NEXT_PUBLIC_DEV_LOGIN=true

# ---------- Microsoft Entra ID SSO (leave empty to disable) ----------
# Web (Auth.js provider)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# API (id_token verification for /auth/entra/exchange)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# ---------- Object storage ----------
# local = filesystem under STORAGE_LOCAL_DIR (no Docker needed); s3 = MinIO / S3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=krama-sources
S3_ACCESS_KEY_ID=krama
S3_SECRET_ACCESS_KEY=krama-minio-secret
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=krama
MINIO_ROOT_PASSWORD=krama-minio-secret

# ---------- iDhi ----------
# mock = canned meetings; http = real iDhi API (TODO: not implemented yet)
IDHI_MODE=mock
IDHI_BASE_URL=
IDHI_API_KEY=

# ---------- Temporal (self-hosted) ----------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ---------- AI worker / model gateway ----------
# stub = deterministic, no credentials (default); bedrock = Claude on Amazon Bedrock
MODEL_PROVIDER=stub
BEDROCK_REGION=ap-south-1
# TODO: set to the model / inference-profile ids enabled for Idealake in ap-south-1
BEDROCK_MODEL_HAIKU=apac.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_SONNET=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_OPUS=apac.anthropic.claude-opus-4-5-20251101-v1:0
# AWS credentials come from the standard chain (instance role / IRSA preferred). Never commit keys.
