{
  "name": "@krama/api",
  "version": "0.1.0",
  "private": true,
  "description": "Krama API (NestJS + Prisma): orchestration entry point, artefacts, approvals, guardrails, audit",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js)",
    "prisma": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "pnpm prisma validate",
    "prisma:migrate": "pnpm prisma migrate dev",
    "prisma:deploy": "pnpm prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@krama/guardrails": "workspace:*",
    "@krama/shared": "workspace:*",
    "@krama/workflows": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@prisma/client": "6.19.3",
    "adm-zip": "0.6.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "docx": "9.15.4",
    "jose": "6.2.17",
    "mammoth": "1.13.0",
    "pdfkit": "0.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.22",
    "@types/adm-zip": "0.6.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pdfkit": "0.17.3",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "unplugin-swc": "2.0.0"
  }
}
