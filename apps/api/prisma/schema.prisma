// Krama data model — BA path and Tech Architect / developer path (BRD v0.6, FSD v0.5 section 23).
// Rules: every table carries tenantId; AuditLog is append-only (trigger in the init migration);
// approved documents and packs are never edited, a change creates a new version.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  SuperAdmin
  TechArchitect
  BALead
  BA
  UIUXLead
  Designer
  Developer
  LeadTester
  Tester
  InfraLead
}

enum Domain {
  BFSI
  MUTUAL_FUNDS
  GENERAL
}

enum EntityType {
  COMMERCIAL_BANK
  NBFC_OTHER_BANK
  PAYMENT_OPERATOR
  INSURER
  AMC
  OTHER
}

enum Phase {
  INTAKE
  BRD
  CLIENT_SIGNOFF
  FSD
  DESIGN
  API_SPEC
  STACK
  DEVELOPMENT
  TESTING
}

enum ProjectStatus {
  ACTIVE
  CANCELLED
  CLOSED
}

enum SourceKind {
  UPLOAD
  IDHI_MEETING
}

enum DocTag {
  SOW
  MOM
  PROCESS
  POLICY
  DESIGN
  API_DOC
  EXISTING_SYSTEM
  OTHER
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  CONSTRAINT
}

enum Priority {
  MUST
  SHOULD
  COULD
}

enum Lens {
  L1
  L2
  L3
  L4
  L5
  L6
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum FindingStatus {
  OPEN
  ANSWERED
  DEFAULT_ACCEPTED
}

enum DocumentType {
  BRD
  FSD
  API_SPEC
}

enum DocStatus {
  DRAFTING
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  CLIENT_SIGNED_OFF
  SUPERSEDED
}

enum AuditStatus {
  READY_FOR_FSD
  NEEDS_CLARIFICATION
  BLOCKED_HIGH_RISK
}

enum PackStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
  WITHDRAWN
}

enum CheckStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ExceptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  REVOKED
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum CapabilityKind {
  AGENT
  TOOL
  PRODUCT
}

enum CapabilityStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  entraTenantId String?  @unique
  createdAt     DateTime @default(now())

  users      User[]
  projects   Project[]
  auditLogs  AuditLog[]
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  email         String
  name          String
  roles         Role[]
  entraObjectId String?
  active        Boolean   @default(true)
  lastSignInAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships ProjectMember[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  addedById String
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([tenantId, userId])
}

model Project {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  code                  String
  name                  String
  clientName            String
  description           String?
  domain                Domain
  entityType            EntityType?
  domainConfirmed       Boolean       @default(false)
  domainConfirmedById   String?
  platforms             String[]
  government            Boolean       @default(false)
  existingProduction    Boolean       @default(false)
  accessibilityRequired Boolean       @default(false)
  sowReference          String?
  clientSignoffOwner    String
  regulations           String?
  integrations          String?
  phase                 Phase         @default(INTAKE)
  status                ProjectStatus @default(ACTIVE)
  stackKey              String?
  stackRationale        String?
  stackSelectedById     String?
  stackSelectedAt       DateTime?
  createdById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  members      ProjectMember[]
  sourceItems  SourceItem[]
  requirements Requirement[]
  findings     LensFinding[]
  documents    Document[]
  audits       DeepAudit[]
  signoffs     ClientSignoff[]
  decisions    Decision[]
  packs        GuardrailPack[]
  checklists   ChecklistConfirmation[]
  checks       ProjectCheck[]
  exceptions   GuardrailException[]
  runs         WorkflowRun[]
  tokenUsages  TokenUsage[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model SourceItem {
  id                   String     @id @default(cuid())
  tenantId             String
  projectId            String
  project              Project    @relation(fields: [projectId], references: [id])
  kind                 SourceKind
  title                String
  mimeType             String?
  sizeBytes            Int?
  storageKey           String?
  externalRef          String?
  docType              DocTag?
  version              String?
  docDate              String?
  provider             String?
  personalData         Boolean    @default(false)
  /// Original extracted text, stored encrypted at rest by the database volume; never sent to AI.
  text                 String?
  /// Masked text: the only text that reaches the AI worker (IN-G01, BRD-DG-02).
  maskedText           String?
  piiFindings          Json       @default("[]")
  injectionFlags       Json       @default("[]")
  maskingConfirmedById String?
  maskingConfirmedAt   DateTime?
  createdById          String
  createdAt            DateTime   @default(now())

  chunks SourceChunk[]

  @@index([tenantId, projectId])
}

model SourceChunk {
  id           String                       @id @default(cuid())
  tenantId     String
  sourceItemId String
  sourceItem   SourceItem                   @relation(fields: [sourceItemId], references: [id])
  ordinal      Int
  text         String
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                     @default(now())

  @@unique([sourceItemId, ordinal])
  @@index([tenantId])
}

model Requirement {
  id                 String          @id @default(cuid())
  tenantId           String
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id])
  documentId         String?
  document           Document?       @relation(fields: [documentId], references: [id])
  code               String
  title              String
  description        String
  type               RequirementType
  priority           Priority
  citations          Json
  acceptanceCriteria Json            @default("[]")
  aiDrafted          Boolean         @default(true)
  confirmed          Boolean         @default(false)
  confirmedById      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tenantId, projectId])
}

model LensFinding {
  id                      String        @id @default(cuid())
  tenantId                String
  projectId               String
  project                 Project       @relation(fields: [projectId], references: [id])
  documentId              String?
  document                Document?     @relation(fields: [documentId], references: [id])
  code                    String
  lens                    Lens
  category                String
  description             String
  severity                Severity
  question                String
  proposedDefault         String
  blocking                Boolean       @default(false)
  relatedRequirementCodes String[]
  status                  FindingStatus @default(OPEN)
  answer                  String?
  resolvedById            String?
  createdAt               DateTime      @default(now())

  @@index([tenantId, projectId])
}

model Document {
  id           String       @id @default(cuid())
  tenantId     String
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  type         DocumentType
  version      Int
  status       DocStatus    @default(DRAFTING)
  content      Json         @default("{}")
  /// Model, prompt template version, source versions, user and time (BRD-DG-07).
  generation   Json         @default("{}")
  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  reviewNote   String?
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  requirements Requirement[]
  findings     LensFinding[]
  audits       DeepAudit[]
  signoffs     ClientSignoff[]

  @@unique([projectId, type, version])
  @@index([tenantId, projectId])
}

model DeepAudit {
  id              String      @id @default(cuid())
  tenantId        String
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id])
  documentId      String
  document        Document    @relation(fields: [documentId], references: [id])
  documentVersion Int
  status          AuditStatus
  criticalCount   Int
  ruleFindings    Json
  aiReport        Json
  createdById     String
  createdAt       DateTime    @default(now())

  @@index([tenantId, projectId])
}

model ClientSignoff {
  id            String    @id @default(cuid())
  tenantId      String
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  documentId    String
  document      Document  @relation(fields: [documentId], references: [id])
  signedByName  String
  signedByEmail String
  signedOn      String
  note          String?
  evidenceKey   String?
  evidenceName  String?
  recordedById  String
  withdrawnAt   DateTime?
  withdrawnNote String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, projectId])
}

/// Architecture Decision Record.
model Decision {
  id           String   @id @default(cuid())
  tenantId     String
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  number       Int
  title        String
  context      String
  decision     String
  consequences String
  createdById  String
  createdAt    DateTime @default(now())

  @@unique([projectId, number])
  @@index([tenantId])
}

/// Guardrails and blueprints generated for a project's domain and stack (BRD-DOM-03, DOM-04).
model GuardrailPack {
  id             String      @id @default(cuid())
  tenantId       String
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id])
  version        Int
  status         PackStatus  @default(SUBMITTED)
  domain         Domain
  entityType     EntityType?
  stackKey       String
  flags          String[]
  /// { rules: CatalogRule[], blueprints: Blueprint[], regulations: Regulation[], checklist: ChecklistItem[] }
  content        Json
  generatedById  String
  approvedById   String?
  approvedAt     DateTime?
  decisionNote   String?
  createdAt      DateTime    @default(now())

  @@unique([projectId, version])
  @@index([tenantId, projectId])
}

model ChecklistConfirmation {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  userId      String
  packVersion Int
  items       Json
  confirmedAt DateTime @default(now())

  @@unique([projectId, userId, packVersion])
  @@index([tenantId, projectId])
}

model ProjectCheck {
  id          String      @id @default(cuid())
  tenantId    String
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id])
  userId      String
  source      String
  ref         String
  packVersion Int
  status      CheckStatus @default(RUNNING)
  passed      Boolean?
  blocking    Int         @default(0)
  warnings    Int         @default(0)
  filesScanned Int        @default(0)
  report      Json        @default("{}")
  error       String?
  createdAt   DateTime    @default(now())

  @@index([tenantId, projectId])
}

model GuardrailException {
  id                  String          @id @default(cuid())
  tenantId            String
  projectId           String
  project             Project         @relation(fields: [projectId], references: [id])
  ruleId              String
  reason              String
  compensatingControl String
  expiresAt           DateTime
  status              ExceptionStatus @default(REQUESTED)
  requestedById       String
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  createdAt           DateTime        @default(now())

  @@index([tenantId, projectId, status])
}

model WorkflowRun {
  id                 String    @id @default(cuid())
  tenantId           String
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id])
  workflowType       String
  temporalWorkflowId String?   @unique
  status             RunStatus @default(RUNNING)
  stage              String    @default("STARTING")
  input              Json      @default("{}")
  error              String?
  startedById        String
  startedAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  finishedAt         DateTime?

  @@index([tenantId, projectId])
}

model Capability {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  version     String
  kind        CapabilityKind
  status      CapabilityStatus @default(DRAFT)
  description String?
  inputs      String[]
  outputs     String[]
  permissions String[]
  evalScore   Float?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, name, version])
}

/// Append-only audit trail. Never updated or deleted (enforced by DB trigger).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actorId    String?
  actorType  String   @default("user")
  action     String
  entityType String
  entityId   String?
  projectId  String?
  data       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, projectId])
  @@index([tenantId, entityType, entityId])
}

model TokenUsage {
  id           String   @id @default(cuid())
  tenantId     String
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  runId        String?
  provider     String
  modelId      String
  tier         String
  task         String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal  @db.Decimal(12, 6)
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}
